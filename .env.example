# =============================================================================
# .env.example — E-Commerce Lakehouse Architecture
# =============================================================================
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
# CI/CD uses GitHub Secrets, not this file.
#
# Naming pattern: all AWS resources follow
#   <PROJECT_PREFIX>-<resource>-<TF_ENV>   (kebab-case for resource names)
#   <PROJECT_PREFIX>_<resource>_<TF_ENV>   (snake_case for catalog/db objects)
# =============================================================================

# -----------------------------------------------------------------------------
# CORE PROJECT CONFIG
# -----------------------------------------------------------------------------

# Environment: dev | prod
TF_ENV=dev

# Project resource prefix (matches architecture.md §3.1)
PROJECT_PREFIX=ecom-lakehouse

# AWS region (we use us-east-1; change only if you have a residency requirement)
AWS_REGION=us-east-1

# Your 12-digit AWS account ID
# Run: aws sts get-caller-identity --query Account --output text
AWS_ACCOUNT_ID=

# AWS profile to use locally (from ~/.aws/config)
# Use "default" if you only have one profile, or the SSO profile name
AWS_PROFILE=default

# -----------------------------------------------------------------------------
# TERRAFORM STATE BOOTSTRAP
# (created manually once — see HUMAN.md §6)
# -----------------------------------------------------------------------------

# S3 bucket for Terraform remote state
# Suggested name: ecom-lakehouse-tf-state-<AWS_ACCOUNT_ID>
TF_BACKEND_BUCKET=

# DynamoDB table for Terraform state locking
TF_BACKEND_LOCK_TABLE=ecom-lakehouse-tf-locks

# Terraform workspace (mirrors TF_ENV)
TF_WORKSPACE=dev

# -----------------------------------------------------------------------------
# S3 BUCKETS
# Auto-derived from PROJECT_PREFIX + TF_ENV — do not change the pattern.
# These are set here for use in local scripts and the Streamlit UI.
# -----------------------------------------------------------------------------

S3_RAW_BUCKET=ecom-lakehouse-raw-dev
S3_STAGING_BUCKET=ecom-lakehouse-staging-dev
S3_DWH_BUCKET=ecom-lakehouse-dwh-dev
S3_ARCHIVE_BUCKET=ecom-lakehouse-archive-dev
S3_QUARANTINE_BUCKET=ecom-lakehouse-quarantine-dev
S3_ATHENA_RESULTS_BUCKET=ecom-lakehouse-athena-results-dev
S3_ARTIFACTS_BUCKET=ecom-lakehouse-artifacts-dev

# -----------------------------------------------------------------------------
# DYNAMODB TABLES (control plane)
# -----------------------------------------------------------------------------

DYNAMODB_LEDGER_TABLE=ecom_lakehouse_ingestion_ledger_dev
DYNAMODB_WATERMARKS_TABLE=ecom_lakehouse_watermarks_dev

# -----------------------------------------------------------------------------
# AWS GLUE
# -----------------------------------------------------------------------------

GLUE_DATABASE=ecom_lakehouse_db_dev

# Glue job names (one per dataset + one optimize job)
GLUE_JOB_INGEST=ecom-lakehouse-ingest-dev
GLUE_JOB_OPTIMIZE=ecom-lakehouse-optimize-dev

# Path to the packaged lakehouse wheel in the artifacts bucket
# (uploaded by CI/CD deploy.yml; set after first deploy)
GLUE_WHEEL_S3_URI=s3://ecom-lakehouse-artifacts-dev/wheels/lakehouse-latest.whl

# Glue worker config (matches ADR-020: 2 workers fixed, G.1X, auto-scaling off)
GLUE_WORKER_TYPE=G.1X
GLUE_NUM_WORKERS=2

# -----------------------------------------------------------------------------
# AWS STEP FUNCTIONS
# -----------------------------------------------------------------------------

# Set after Terraform creates the state machine
STEP_FUNCTIONS_ARN=arn:aws:states:us-east-1:ACCOUNT_ID:stateMachine:ecom-lakehouse-sm-dev

# -----------------------------------------------------------------------------
# AMAZON ATHENA
# -----------------------------------------------------------------------------

ATHENA_WORKGROUP=ecom_lakehouse_wg_dev
ATHENA_DATABASE=ecom_lakehouse_db_dev
ATHENA_RESULTS_URI=s3://ecom-lakehouse-athena-results-dev/

# -----------------------------------------------------------------------------
# AWS LAMBDA FUNCTIONS
# (names set after Terraform deploy)
# -----------------------------------------------------------------------------

LAMBDA_NORMALIZE_FUNCTION=ecom-lakehouse-normalize-dev
LAMBDA_CLAIM_FUNCTION=ecom-lakehouse-claim-dev
LAMBDA_ARCHIVE_FUNCTION=ecom-lakehouse-archive-dev
LAMBDA_VALIDATE_SCHEMA_FUNCTION=ecom-lakehouse-validate-schema-dev

# -----------------------------------------------------------------------------
# KMS
# (ARNs set after Terraform creates the keys)
# -----------------------------------------------------------------------------

# prod: CMK ARN; dev: leave blank to use AWS-managed key (ADR-017)
KMS_S3_KEY_ARN=
KMS_DYNAMODB_KEY_ARN=
KMS_LOGS_KEY_ARN=

# -----------------------------------------------------------------------------
# SNS / ALERTING
# -----------------------------------------------------------------------------

# Email address for pipeline failure/warning alerts
# Must match what you set in Terraform variables — you will receive a
# confirmation email after first terraform apply (you must click it)
ALERT_EMAIL=

# SNS topic ARN (set after Terraform deploy)
SNS_ALERTS_TOPIC_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:ecom-lakehouse-alerts-dev

# -----------------------------------------------------------------------------
# GITHUB ACTIONS / CI-CD
# (these are also set as GitHub repository Secrets — see HUMAN.md §4b)
# -----------------------------------------------------------------------------

# IAM role assumed by GitHub Actions via OIDC (ADR-013)
# Set after running Terraform bootstrap
GHA_DEPLOY_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/ecom-lakehouse-gha-deploy-role

GITHUB_ORG=
GITHUB_REPO=ecom-lakehouse

# -----------------------------------------------------------------------------
# PIPELINE BEHAVIOUR
# -----------------------------------------------------------------------------

# Reject rate threshold above which a run is failed (ADR-008, data_validation.md)
REJECT_RATE_THRESHOLD=0.05

# Default dataset load order (comma-separated; must respect FK dependencies)
DATASET_LOAD_ORDER=products,orders,order_items

# -----------------------------------------------------------------------------
# STREAMLIT UI
# (docs/ui_streamlit.md — local dev only; reads from your AWS_PROFILE creds)
# -----------------------------------------------------------------------------

# Page title / env banner in the UI
UI_ENV_LABEL=dev

# Max rows to return in the Data Explorer (Athena cost guardrail)
UI_ATHENA_MAX_ROWS=1000

# Athena query timeout in seconds
UI_ATHENA_TIMEOUT_SECONDS=60

# Whether to show the Batch Trigger page (disable in prod-pointed UI)
UI_ENABLE_TRIGGER=true

# Optional: deployed UI role ARN (leave blank for local dev — uses AWS_PROFILE)
UI_ROLE_ARN=

# -----------------------------------------------------------------------------
# LOCAL DEVELOPMENT HELPERS
# -----------------------------------------------------------------------------

# Absolute path to the project root (useful for local scripts)
PROJECT_ROOT=

# Log level for local runs
LOG_LEVEL=INFO

# Local Delta warehouse path for unit tests (pytest conftest.py)
# Leave blank to use a tmp dir (auto-managed by tests)
LOCAL_DELTA_WAREHOUSE=
